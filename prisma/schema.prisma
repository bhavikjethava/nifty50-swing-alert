generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Stock {
  id        Int      @id @default(autoincrement())
  symbol    String   @unique
  name      String
  sector    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  news       News[]
  alerts     Alert[]
  snapshots  TechnicalSnapshot[]
}

model News {
  id          Int       @id @default(autoincrement())
  stockId     Int
  title       String
  source      String
  url         String    @unique
  summary     String?
  sentiment   String
  publishedAt DateTime
  createdAt   DateTime  @default(now())

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, publishedAt])
  @@index([sentiment, publishedAt])
}

model TechnicalSnapshot {
  id           Int       @id @default(autoincrement())
  stockId      Int
  price        Float
  volume       Float
  ema20        Float
  ema50        Float
  ema200       Float
  avgVolume20  Float
  trend        String
  reasons      String
  holdMinDays    Int     @default(0)
  holdMaxDays    Int     @default(0)
  holdConfidence String  @default("LOW")
  exitRule       String  @default("")
  scannedAt    DateTime  @default(now())

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, scannedAt])
  @@index([trend, scannedAt])
}

model PaperAccount {
  id              Int      @id @default(autoincrement())
  startingCapital Float    @default(50000)
  cash            Float    @default(50000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PaperPosition {
  id           Int       @id @default(autoincrement())
  symbol       String
  quantity     Int
  entryPrice   Float
  entryDate    DateTime  @default(now())
  holdMaxDays  Int
  status       String    @default("OPEN") // OPEN | CLOSED
  exitPrice    Float?
  exitDate     DateTime?
  exitReason   String?            // ema20-reclaim | horizon
  realizedPnl  Float?

  @@index([status, symbol])
}

model Backtest {
  id               Int      @id @default(autoincrement())
  symbol           String   @unique
  trades           Int
  wins             Int
  winRate          Float
  avgReturnPct     Float
  totalReturnPct   Float
  buyHoldReturnPct Float
  avgHeldDays      Float
  ranAt            DateTime @default(now())
}

model Alert {
  id        Int      @id @default(autoincrement())
  stockId   Int
  signal    String
  price     Float
  message   String
  sentAt    DateTime?
  createdAt DateTime @default(now())

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, createdAt])
  @@index([signal, createdAt])
}
